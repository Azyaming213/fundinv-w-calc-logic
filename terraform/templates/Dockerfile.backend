# ── FundInv Backend — FastAPI production image ──
# Build:  docker build -f terraform/templates/Dockerfile.backend -t fundinv-backend .
# Run:    docker run -p 8000:8000 --env-file .env fundinv-backend

FROM python:3.12-slim

# WeasyPrint system dependencies (Cairo, Pango, GDK-Pixbuf, GLib)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcairo2 \
    libpango-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libgdk-pixbuf2.0-common \
    libffi-dev \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY Server/ .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/test')" || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
